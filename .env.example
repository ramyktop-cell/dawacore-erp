# ═══════════════════════════════════════════════════════════════
# DawaCore — Environment Variables
# ═══════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك.
# ⚠️ لا ترفع .env إلى git!
# ═══════════════════════════════════════════════════════════════

# ─── App
NODE_ENV=development
PORT=3000

# ─── Database
DATABASE_URL=postgresql://dawa:dawa_dev_password@localhost:5432/dawacore_dev?schema=public
DB_USER=dawa
DB_PASSWORD=dawa_dev_password
DB_NAME=dawacore_dev
DB_PORT=5432

# ─── Redis (اختياري — للإنتاج multi-node)
# لو لم يُحدَّد، يتم استخدام LRU in-memory cache
# REDIS_URL=redis://:dawa_redis_pass@localhost:6379
REDIS_PASSWORD=dawa_redis_pass
REDIS_PORT=6379

# ─── Auth
JWT_SECRET=change-me-in-production-with-strong-random-string
JWT_EXPIRES_IN=7d

# ─── Reports
# اتركه فارغاً لو تريد استخدام LRU in-memory
# REPORTS_CACHE_DRIVER=redis

# ─── Platform Branding & Deployment Mode
PLATFORM_NAME=MadarCore
PLATFORM_NAME_AR=مدار كور
PLATFORM_LOGO_URL=/logo.png
PLATFORM_PRIMARY_COLOR=#582949
PLATFORM_SECONDARY_COLOR=#00A8A8
DEPLOYMENT_MODE=OFFLINE

