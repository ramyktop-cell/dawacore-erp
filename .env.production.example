# ==============================================================================
# DawaCore ERP - Production Environment Variables Template
# Copy this file to `.env` before running `docker compose up -d --build`
# ==============================================================================

# --- Application & Web Server ---
NODE_ENV=production
APP_PORT=80
TZ=Africa/Khartoum

# Set AUTO_SEED=true only on the very first run to populate default accounts & admin user
AUTO_SEED=true

# --- PostgreSQL 16 Database ---
POSTGRES_USER=dawacore
POSTGRES_PASSWORD=ChangeMe_To_A_Very_Strong_Password_2026!
POSTGRES_DB=dawacore_prod
DATABASE_URL=postgresql://dawacore:ChangeMe_To_A_Very_Strong_Password_2026!@postgres:5432/dawacore_prod?schema=public

# --- Redis 7 Report Cache ---
REDIS_URL=redis://redis:6379

# --- JWT Security & Authentication ---
JWT_SECRET=ChangeMe_To_A_64_Char_Random_Hex_Secret_Key_For_Production_2026!
JWT_EXPIRES_IN=12h

# --- Automated Backup Policy ---
# Keep daily backups for 30 days (rotates older archives automatically)
BACKUP_RETENTION_DAYS=30
# Interval between automatic backups in seconds (86400 = 24 hours)
BACKUP_INTERVAL_SECONDS=86400
